# --- Gemini (free tier, no credit card): https://aistudio.google.com ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3.8-flash          # change if Google retires this name
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# true  = read pre-written tag JSON from data/mock_vision/ (no vision API calls)
# false = call Gemini vision live (free tier: ~5 req/min and a small daily cap)
USE_MOCK_VISION=true

# Leave EMBEDDING_BACKEND unset: it is "gemini" when GEMINI_API_KEY is set, else "local"
# (hash vectors: plumbing/tests only, NOT semantic). Force it with EMBEDDING_BACKEND=gemini|local.
# EMBEDDING_BACKEND=gemini

# Database. SQLite works with zero setup; Postgres via `docker compose up`.
DATABASE_URL=sqlite:///./capstone.db

# Mismatch guard thresholds. Unset = 0.75 for gemini embeddings (calibrated on this
# corpus; re-tune with `python scripts/tune_threshold.py`) or 0.12 for the local backend.
# SIMILARITY_THRESHOLD=0.75
CONFIDENCE_THRESHOLD=0.6

# Budget guard / rate limiting for live vision calls
DAILY_VISION_CALL_LIMIT=20
VISION_DELAY_SECONDS=13
DAILY_BUDGET_USD=0
